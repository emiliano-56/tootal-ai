# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored and must NEVER be committed or zipped.

# ---- Supabase ----
# Safe to expose in the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — bypasses all Row Level Security. Server-side only.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- AI ----
# SECRET — used by all agents. Server-side only.
DEEPSEEK_API_KEY=your-deepseek-key

# ---- Generation backend ----
NEXT_PUBLIC_API_URL=https://zoop-a1-v2.onrender.com
